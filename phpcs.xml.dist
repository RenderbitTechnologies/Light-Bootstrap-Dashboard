<?xml version="1.0"?>
<ruleset name="LightBootstrapDashboard">
    <description>PSR-2 coding standard for the package sources and tests.</description>

    <file>src</file>
    <file>tests</file>

    <arg name="extensions" value="php"/>
    <arg value="p"/>

    <!-- Blade templates are not plain PHP. -->
    <exclude-pattern>*.blade.php</exclude-pattern>

    <rule ref="PSR2"/>
</ruleset>
