{
    "name": "renderbit/light-bootstrap-dashboard",
    "type": "library",
    "description": "Light Bootstrap Dashboard by Creative Tim, packaged as Blade layouts and components for Laravel",
    "keywords": [
        "RenderbitTechnologies",
        "LightBootstrapDashboard"
    ],
    "homepage": "https://github.com/RenderbitTechnologies/Light-Bootstrap-Dashboard",
    "license": "MIT",
    "authors": [
        {
            "name": "Renderbit Technologies",
            "email": "contact@renderbit.com",
            "homepage": "https://github.com/RenderbitTechnologies",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^7.4|^8.0",
        "illuminate/routing": "^5.7|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/support": "^5.7|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0",
        "lavary/laravel-menu": "^1.8"
    },
    "require-dev": {
        "orchestra/testbench": "^3.7|^4.0|^5.0|^6.0|^7.0|^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^7.5|^8.5|^9.5|^10.5|^11.5",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "files": [
            "src/helpers.php"
        ],
        "psr-4": {
            "RenderbitTechnologies\\LightBootstrapDashboard\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RenderbitTechnologies\\LightBootstrapDashboard\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit",
        "check-style": "phpcs",
        "fix-style": "phpcbf"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "7.x-dev"
        },
        "laravel": {
            "providers": [
                "RenderbitTechnologies\\LightBootstrapDashboard\\LightBootstrapDashboardServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
